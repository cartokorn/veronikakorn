---
interface Artwork {
  id: string;
  title: string;
  year?: number;
  technique?: string;
  price?: number;
  currency?: string;
  status?: string;
  image: string;
  width_cm?: number;
  height_cm?: number;
  edition_size?: number;
  category?: string;
}

interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;
const isSold = artwork.status === 'sold';
const isPrint = artwork.category === 'print';
---

<a href={`/works/${artwork.id}`} class="card" aria-label={`${artwork.title}${artwork.year ? ', ' + artwork.year : ''}`}>
  <div class="card-image-wrap">
    <img
      src={artwork.image}
      alt={artwork.title ?? ''}
      loading="lazy"
      class="card-image"
      width="400"
      height="500"
    />
    {isSold && <span class="badge sold-badge">Verkauft</span>}
    {isPrint && artwork.edition_size && (
      <span class="badge edition-badge">Auflage {artwork.edition_size}</span>
    )}
  </div>
  <div class="card-info">
    <h3 class="card-title">{artwork.title}</h3>
    {(artwork.year || artwork.technique) && (
      <p class="card-meta">
        {[artwork.year, artwork.technique].filter(Boolean).join(' · ')}
      </p>
    )}
    <p class="card-price">
      {isSold
        ? 'Verkauft'
        : artwork.price && artwork.currency
          ? `${artwork.currency} ${artwork.price.toLocaleString('de-AT')}`
          : ''}
    </p>
  </div>
</a>

<style>
  .card {
    display: block;
    cursor: pointer;
  }

  .card-image-wrap {
    position: relative;
    overflow: hidden;
    background: var(--border);
    aspect-ratio: 4 / 5;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card:hover .card-image {
    transform: scale(1.03);
  }

  .badge {
    position: absolute;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    backdrop-filter: blur(4px);
  }

  .sold-badge {
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(28, 28, 26, 0.65);
    color: #f8f6f2;
  }

  .edition-badge {
    top: 0.75rem;
    right: 0.75rem;
    background: rgba(248, 246, 242, 0.85);
    color: var(--text);
  }

  .card-info {
    padding: 0.875rem 0 0;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 400;
    margin-bottom: 0.25rem;
    line-height: 1.3;
  }

  .card-meta {
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-bottom: 0.3rem;
    line-height: 1.4;
  }

  .card-price {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 400;
  }
</style>
