---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Seite nicht gefunden – Veronika Korn" description="Die angeforderte Seite wurde nicht gefunden.">
  <section class="not-found">
    <div class="container">
      <p class="code">404</p>
      <h1>Seite nicht gefunden</h1>
      <p class="text">Die gesuchte Seite existiert nicht oder wurde verschoben.</p>
      <a href="/" class="btn-outline">Zur Startseite</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding: 8rem 0;
    text-align: center;
  }

  .code {
    font-family: var(--font-serif);
    font-size: 6rem;
    color: var(--border);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .not-found h1 {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    margin-bottom: 1rem;
  }

  .text {
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }

  .btn-outline {
    display: inline-block;
    border: 1px solid var(--text);
    padding: 0.625rem 1.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      background 0.25s,
      color 0.25s;
  }

  .btn-outline:hover {
    background: var(--text);
    color: var(--bg);
  }
</style>
