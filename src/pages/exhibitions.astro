---
import Layout from '../layouts/Layout.astro';
import exhibitions from '../data/exhibitions.json';

const upcoming = exhibitions
  .filter((e) => e.upcoming)
  .sort((a, b) => b.year - a.year);

const past = exhibitions
  .filter((e) => !e.upcoming)
  .sort((a, b) => b.year - a.year);
---

<Layout
  title="Ausstellungen – Veronika Korn"
  description="Ausstellungen und Lebenslauf von Veronika Korn, Malerin aus Wien."
>
  <section class="page-hero">
    <div class="container">
      <h1>Ausstellungen</h1>
    </div>
  </section>

  <section class="exhibitions-section">
    <div class="container">
      {
        upcoming.length > 0 && (
          <div class="group">
            <h2 class="group-label">Kommende Ausstellungen</h2>
            <ul class="list" role="list">
              {upcoming.map((ex) => (
                <li class="item upcoming">
                  <span class="item-date">{ex.date ?? ex.year}</span>
                  <div class="item-info">
                    <strong class="item-title">{ex.title}</strong>
                    <span class="item-venue">
                      {ex.venue}, {ex.location}
                    </span>
                    <span class="item-type">{ex.type}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="group">
        <h2 class="group-label">Vergangene Ausstellungen</h2>
        <ul class="list" role="list">
          {
            past.map((ex) => (
              <li class="item">
                <span class="item-date">{ex.date ?? ex.year}</span>
                <div class="item-info">
                  <strong class="item-title">{ex.title}</strong>
                  <span class="item-venue">
                    {ex.venue}, {ex.location}
                  </span>
                  <span class="item-type">{ex.type}</span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }

  .page-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  .exhibitions-section {
    padding: 4rem 0 6rem;
    max-width: 820px;
  }

  .group {
    margin-bottom: 4rem;
  }

  .group-label {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 2rem;
    padding-bottom: 0.875rem;
    border-bottom: 1px solid var(--border);
  }

  .list {
    list-style: none;
    display: grid;
    gap: 0;
  }

  .item {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }

  .item:last-child {
    border-bottom: none;
  }

  .item-date {
    font-size: 0.78rem;
    color: var(--text-muted);
    padding-top: 0.15rem;
    line-height: 1.4;
  }

  .item-info {
    display: grid;
    gap: 0.2rem;
  }

  .item-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.3;
  }

  .item-venue,
  .item-type {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .upcoming .item-title {
    color: var(--accent);
  }

  .upcoming .item-date {
    color: var(--accent);
    opacity: 0.8;
  }

  @media (max-width: 480px) {
    .item {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }
  }
</style>
