---
import Layout from '../layouts/Layout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import artworks from '../data/artworks.json';

const originals = artworks.filter((a) => a.category === 'original');
---

<Layout
  title="Werke – Veronika Korn"
  description="Alle Ölgemälde von Veronika Korn. Originale auf Leinwand und Holz aus Wien."
>
  <section class="page-hero">
    <div class="container">
      <h1>Werke</h1>
      <p class="subtitle">Originale Ölgemälde auf Leinwand und Holz</p>
    </div>
  </section>

  <section class="gallery-section">
    <div class="container">
      <div class="gallery-grid">
        {originals.map((artwork) => <ArtworkCard artwork={artwork} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }

  .page-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
  }

  .gallery-section {
    padding: 4rem 0 6rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1rem;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      gap: 2.5rem 1.5rem;
    }
  }

  @media (min-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
