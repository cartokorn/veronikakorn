---
import Layout from '../layouts/Layout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import artworks from '../data/artworks.json';

const featured = artworks.filter((a) => a.featured);
const heroWork = featured[0];
const gridWorks = artworks
  .filter((a) => a.category === 'original')
  .slice(0, 4);
---

<Layout
  title="Veronika Korn – Malerin, Wien"
  description="Abstrakte Malerei und limitierte Drucke einer Wiener Malerin. Originale in Acryl und Öl."
  ogImage={heroWork?.image}
>
  <!-- Hero -->
  <section class="hero">
    {
      heroWork && (
        <div class="hero-image-wrap">
          <img
            src={heroWork.image}
            alt={heroWork.title}
            class="hero-image"
            loading="eager"
            fetchpriority="high"
            width="1600"
            height="1000"
          />
          <div class="hero-overlay">
            <h1 class="hero-name">Veronika Korn</h1>
            <p class="hero-statement">Abstrakte Malerei aus Wien — Gefühl, Stimmung, innere Bewegung.</p>
          </div>
        </div>
      )
    }
  </section>

  <!-- Selected Works -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Auswahl an Werke</h2>
        <a href="/gallery" class="link-arrow">Alle Werke →</a>
      </div>
      <div class="grid">
        {gridWorks.map((artwork) => <ArtworkCard artwork={artwork} />)}
      </div>
    </div>
  </section>

  <!-- Artist Statement -->
  <section class="statement-section">
    <div class="container">
      <div class="statement-inner">
        <p class="statement-quote">
          „Oft entsteht ein Bild spontan aus einem Gefühl, einer Stimmung oder einer inneren
          Bewegung."
        </p>
        <a href="/about" class="btn-outline">Über die Künstlerin</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero {
    width: 100%;
    border-bottom: 1px solid var(--border);
  }

  .hero-image-wrap {
    position: relative;
    display: block;
  }

  .hero-image {
    width: 100%;
    max-height: 80vh;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.24));
  }

  .hero-name {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 6vw, 5rem);
    font-weight: 400;
    letter-spacing: 0.06em;
    color: #fff;
    margin: 0 0 0.75rem;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }

  .hero-statement {
    font-size: clamp(0.75rem, 1.8vw, 1rem);
    color: rgba(255, 255, 255, 0.92);
    letter-spacing: 0.08em;
    margin: 0;
    text-transform: none;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.28);
  }

  .section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    gap: 1rem;
  }

  .section-header h2 {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
  }

  .link-arrow {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color 0.2s;
    white-space: nowrap;
  }

  .link-arrow:hover {
    color: var(--text);
  }

  .section-text {
    color: var(--text-muted);
    max-width: 52ch;
    line-height: 1.8;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem 1.5rem;
    }
  }

  .statement-section {
    padding: 5rem 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .statement-inner {
    max-width: 56ch;
  }

  .statement-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    line-height: 1.6;
    color: var(--text);
    margin-bottom: 2rem;
  }

  .btn-outline {
    display: inline-block;
    border: 1px solid var(--text);
    padding: 0.625rem 1.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      background 0.25s,
      color 0.25s;
  }

  .btn-outline:hover {
    background: var(--text);
    color: var(--bg);
  }
</style>
